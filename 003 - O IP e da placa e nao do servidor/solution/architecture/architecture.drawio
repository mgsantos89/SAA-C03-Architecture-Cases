<mxfile host="app.diagrams.net">
  <diagram id="case003-inicial" name="1 - Inicial (IP preso ao servidor)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="case003-inicial-title" value="&lt;b&gt;Case 03 — Arquitetura inicial (o IP do serviço é o IP da eth0)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;Os 12 clientes chamam o motor de cotação pelo IP privado da &lt;b&gt;eth0&lt;/b&gt; do servidor. Quando o servidor foi substituído, o IP foi junto. Nomes e IPs são &lt;b&gt;simulados&lt;/b&gt;.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="50" as="geometry" /></mxCell>
        <mxCell id="case003-inicial-cloud" value="AWS Cloud" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1060" height="780" as="geometry" /></mxCell>
        <mxCell id="case003-inicial-region" value="Region us-east-1" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;fontColor=#147EBA;dashed=1;" vertex="1" parent="case003-inicial-cloud"><mxGeometry x="20" y="40" width="1020" height="720" as="geometry" /></mxCell>
        <mxCell id="case003-inicial-vpc" value="VPC Cedro Seguros (simulada) — 172.31.0.0/16" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;fontColor=#AAB7B8;dashed=0;" vertex="1" parent="case003-inicial-region"><mxGeometry x="20" y="40" width="980" height="660" as="geometry" /></mxCell>
        <mxCell id="case003-inicial-aza" value="us-east-1a" style="fillColor=none;strokeColor=#147EBA;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#147EBA;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fontSize=12;" vertex="1" parent="case003-inicial-vpc"><mxGeometry x="20" y="40" width="460" height="600" as="geometry" /></mxCell>
        <mxCell id="case003-inicial-suba" value="Sub-rede privada 172.31.0.0/20" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#147EBA;fillColor=#E6F2F8;fontColor=#147EBA;dashed=0;" vertex="1" parent="case003-inicial-aza"><mxGeometry x="15" y="35" width="430" height="550" as="geometry" /></mxCell>
        <mxCell id="case003-inicial-old" value="motor-cotacao (antigo)&lt;br&gt;&lt;b&gt;FALHOU&lt;/b&gt;&lt;br&gt;eth0: 172.31.14.223&lt;br&gt;(IP morre com a eth0)" style="sketch=0;outlineConnect=0;fontColor=#DD3522;gradientColor=none;fillColor=#DD3522;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.instance2;" vertex="1" parent="case003-inicial-suba"><mxGeometry x="70" y="90" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="case003-inicial-new" value="motor-cotacao (novo)&lt;br&gt;eth0: &lt;b&gt;172.31.10.198&lt;/b&gt;&lt;br&gt;(IP diferente)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.instance2;" vertex="1" parent="case003-inicial-suba"><mxGeometry x="70" y="330" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="case003-inicial-orf" value="ENIs órfãs (Available)&lt;br&gt;eth0 com Delete on termination&lt;br&gt;desligado: ocupam IP e&lt;br&gt;travam a exclusão de SGs" style="sketch=0;outlineConnect=0;fontColor=#DD3522;gradientColor=none;fillColor=#DD3522;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.elastic_network_interface;" vertex="1" parent="case003-inicial-suba"><mxGeometry x="290" y="450" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="case003-inicial-azb" value="us-east-1b" style="fillColor=none;strokeColor=#147EBA;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#147EBA;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fontSize=12;" vertex="1" parent="case003-inicial-vpc"><mxGeometry x="500" y="40" width="460" height="600" as="geometry" /></mxCell>
        <mxCell id="case003-inicial-subb" value="Sub-rede privada (clientes)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#147EBA;fillColor=#E6F2F8;fontColor=#147EBA;dashed=0;" vertex="1" parent="case003-inicial-azb"><mxGeometry x="15" y="35" width="430" height="550" as="geometry" /></mxCell>
        <mxCell id="case003-inicial-c1" value="ERP" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.instance2;" vertex="1" parent="case003-inicial-subb"><mxGeometry x="60" y="90" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="case003-inicial-c2" value="Jobs batch" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.instance2;" vertex="1" parent="case003-inicial-subb"><mxGeometry x="190" y="90" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="case003-inicial-c3" value="Relatórios" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.instance2;" vertex="1" parent="case003-inicial-subb"><mxGeometry x="320" y="90" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="case003-inicial-cn" value="… &lt;b&gt;12 servidores clientes&lt;/b&gt;, cada um com o IP&lt;br&gt;&lt;b&gt;172.31.14.223&lt;/b&gt; gravado em arquivo de configuração" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="case003-inicial-subb"><mxGeometry x="130" y="170" width="290" height="60" as="geometry" /></mxCell>
        <mxCell id="case003-inicial-cx" value="&lt;b&gt;Reserva em outra AZ?&lt;/b&gt;&lt;br&gt;Uma ENI da us-east-1a &lt;b&gt;não pode&lt;/b&gt; ser anexada aqui:&lt;br&gt;a placa pertence à sub-rede, e a sub-rede a uma única AZ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFF8E6;strokeColor=#D79B00;" vertex="1" parent="case003-inicial-subb"><mxGeometry x="40" y="380" width="360" height="90" as="geometry" /></mxCell>
        <mxCell id="case003-inicial-e1" value="IP fixo da eth0 antiga → sem resposta" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#DD3522;fontColor=#DD3522;fontSize=10;labelBackgroundColor=#FFFFFF;;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="case003-inicial-c1" target="case003-inicial-old"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="case003-inicial-e2" value="~2 h editando e reiniciando 12 clientes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#8C4FFF;fontColor=#8C4FFF;fontSize=10;labelBackgroundColor=#FFFFFF;;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="case003-inicial-c1" target="case003-inicial-new"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="679" y="579" /></Array></mxGeometry></mxCell>
        <mxCell id="case003-inicial-notes" value="&lt;b&gt;Reclamações do pós-incidente&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&#x27;#DD3522&#x27;&gt;&lt;b&gt;① 2 h de indisponibilidade&lt;/b&gt;&lt;/font&gt;&lt;br&gt;O servidor novo subiu em 10 min, mas com outro IP. Foi preciso editar os 12 clientes à mão.&lt;br&gt;&lt;br&gt;&lt;font color=&#x27;#DD3522&#x27;&gt;&lt;b&gt;② &quot;É só usar um Elastic IP&quot;&lt;/b&gt;&lt;/font&gt;&lt;br&gt;EIP é IP &lt;b&gt;público&lt;/b&gt;. Os clientes falam pelo IP &lt;b&gt;privado&lt;/b&gt; dentro da VPC.&lt;br&gt;&lt;br&gt;&lt;font color=&#x27;#DD3522&#x27;&gt;&lt;b&gt;③ &quot;Reserva em outra AZ&quot;&lt;/b&gt;&lt;/font&gt;&lt;br&gt;A ENI é presa à AZ/sub-rede, então o IP não acompanha a troca.&lt;br&gt;&lt;br&gt;&lt;font color=&#x27;#DD3522&#x27;&gt;&lt;b&gt;④ ENIs órfãs&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Ao desligar o Delete on termination da eth0 &quot;para não perder o IP&quot;, as placas ficaram Available na conta.&lt;br&gt;&lt;br&gt;&lt;b&gt;Premissa errada por trás de tudo&lt;/b&gt;&lt;br&gt;&quot;O IP pertence ao servidor.&quot; Na AWS, ele pertence à &lt;b&gt;placa de rede (ENI)&lt;/b&gt;." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFF8E6;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1130" y="90" width="330" height="470" as="geometry" /></mxCell>
        <mxCell id="case003-inicial-legend" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;■ &lt;font color=&#x27;#ED7100&#x27;&gt;EC2 em operação&lt;/font&gt;&lt;br&gt;■ &lt;font color=&#x27;#DD3522&#x27;&gt;EC2 / ENI com problema&lt;/font&gt;&lt;br&gt;⇢ &lt;font color=&#x27;#DD3522&#x27;&gt;Chamada que falha&lt;/font&gt;&lt;br&gt;⇢ &lt;font color=&#x27;#8C4FFF&#x27;&gt;Reconfiguração manual&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFFFFF;strokeColor=#879196;" vertex="1" parent="1"><mxGeometry x="1130" y="580" width="330" height="110" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="case003-implementada" name="2 - Implementada (ENI do serviço)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="case003-implementada-title" value="&lt;b&gt;Case 03 — Arquitetura implementada no lab (o IP mora na ENI)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;O IP do serviço &lt;b&gt;172.31.10.100&lt;/b&gt; fica numa ENI dedicada, que migra de case003-app-a para case003-app-b na mesma AZ. Recursos e IPs reais do lab.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="50" as="geometry" /></mxCell>
        <mxCell id="case003-implementada-cloud" value="AWS Cloud" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1060" height="860" as="geometry" /></mxCell>
        <mxCell id="case003-implementada-region" value="Region us-east-1" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;fontColor=#147EBA;dashed=1;" vertex="1" parent="case003-implementada-cloud"><mxGeometry x="20" y="40" width="1020" height="800" as="geometry" /></mxCell>
        <mxCell id="case003-implementada-vpc" value="VPC default — 172.31.0.0/16" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;fontColor=#AAB7B8;dashed=0;" vertex="1" parent="case003-implementada-region"><mxGeometry x="20" y="40" width="980" height="740" as="geometry" /></mxCell>
        <mxCell id="case003-implementada-aza" value="us-east-1a" style="fillColor=none;strokeColor=#147EBA;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#147EBA;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fontSize=12;" vertex="1" parent="case003-implementada-vpc"><mxGeometry x="20" y="40" width="460" height="680" as="geometry" /></mxCell>
        <mxCell id="case003-implementada-suba" value="subnet-06a1d0ee347d4732d — 172.31.0.0/20" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#147EBA;fillColor=#E6F2F8;fontColor=#147EBA;dashed=0;" vertex="1" parent="case003-implementada-aza"><mxGeometry x="15" y="35" width="430" height="630" as="geometry" /></mxCell>
        <mxCell id="case003-implementada-sga" value="SG case003-app-sg · 80/tcp somente de case003-cliente-sg" style="rounded=0;fillColor=none;strokeColor=#DD3522;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=8;fontStyle=0;fontColor=#DD3522;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fontSize=11;" vertex="1" parent="case003-implementada-suba"><mxGeometry x="15" y="40" width="400" height="570" as="geometry" /></mxCell>
        <mxCell id="case003-implementada-a" value="&lt;b&gt;case003-app-a&lt;/b&gt;&lt;br&gt;(falha simulada)&lt;br&gt;eth0 172.31.14.223&lt;br&gt;DoT true → apagada" style="sketch=0;outlineConnect=0;fontColor=#545B64;gradientColor=none;fillColor=#879196;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.instance2;" vertex="1" parent="case003-implementada-sga"><mxGeometry x="50" y="60" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="case003-implementada-b" value="&lt;b&gt;case003-app-b&lt;/b&gt;&lt;br&gt;(reserva → ativo)&lt;br&gt;eth0 172.31.10.198&lt;br&gt;DoT false → &lt;font color=&#x27;#DD3522&#x27;&gt;órfã&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.instance2;" vertex="1" parent="case003-implementada-sga"><mxGeometry x="290" y="60" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="case003-implementada-eni" value="&lt;b&gt;case003-eni-servico&lt;/b&gt;&lt;br&gt;IP &lt;b&gt;172.31.10.100&lt;/b&gt; (Custom)&lt;br&gt;MAC 02:ff:ff:f8:a6:a3&lt;br&gt;device index 1 · DoT false" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.elastic_network_interface;" vertex="1" parent="case003-implementada-sga"><mxGeometry x="176" y="300" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="case003-implementada-eninote" value="Mesmo IP e mesmo MAC antes e depois.&lt;br&gt;A eth0 (index 0) &lt;b&gt;não pode&lt;/b&gt; ser desanexada,&lt;br&gt;nem com Force detachment." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="case003-implementada-sga"><mxGeometry x="70" y="470" width="300" height="60" as="geometry" /></mxCell>
        <mxCell id="case003-implementada-ea" value="① até 20:15:12 UTC&lt;br&gt;(force detach)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#879196;fontColor=#545B64;fontSize=10;labelBackgroundColor=#FFFFFF;;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="case003-implementada-eni" target="case003-implementada-a"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="case003-implementada-eb" value="② desde 20:15:34 UTC&lt;br&gt;(attach)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeWidth=2;strokeColor=#248814;fontColor=#248814;fontSize=10;labelBackgroundColor=#FFFFFF;;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="case003-implementada-eni" target="case003-implementada-b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="case003-implementada-azb" value="us-east-1b" style="fillColor=none;strokeColor=#147EBA;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#147EBA;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fontSize=12;" vertex="1" parent="case003-implementada-vpc"><mxGeometry x="500" y="40" width="460" height="680" as="geometry" /></mxCell>
        <mxCell id="case003-implementada-subb" value="subnet-0488c49afc72f8ba8" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#147EBA;fillColor=#E6F2F8;fontColor=#147EBA;dashed=0;" vertex="1" parent="case003-implementada-azb"><mxGeometry x="15" y="35" width="430" height="630" as="geometry" /></mxCell>
        <mxCell id="case003-implementada-sgc" value="SG case003-cliente-sg" style="rounded=0;fillColor=none;strokeColor=#DD3522;strokeWidth=1;dashed=0;verticalAlign=top;align=left;spacingLeft=8;fontStyle=0;fontColor=#DD3522;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fontSize=11;" vertex="1" parent="case003-implementada-subb"><mxGeometry x="15" y="40" width="400" height="570" as="geometry" /></mxCell>
        <mxCell id="case003-implementada-cli" value="&lt;b&gt;case003-cliente&lt;/b&gt;&lt;br&gt;172.31.90.255&lt;br&gt;(1 dos 12 clientes)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.instance2;" vertex="1" parent="case003-implementada-sgc"><mxGeometry x="176" y="300" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="case003-implementada-clinote" value="&lt;code&gt;curl http://172.31.10.100&lt;/code&gt; a cada 5 s&lt;br&gt;Nenhuma alteração durante o failover." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="case003-implementada-sgc"><mxGeometry x="70" y="470" width="300" height="50" as="geometry" /></mxCell>
        <mxCell id="case003-implementada-http" value="HTTP :80 → 172.31.10.100&lt;br&gt;(SG referenciando SG)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#147EBA;fontColor=#147EBA;fontSize=10;labelBackgroundColor=#FFFFFF;;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="case003-implementada-cli" target="case003-implementada-eni"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="case003-implementada-block" value="✖ attach em outra AZ&lt;br&gt;InvalidParameterCombination" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#DD3522;fontColor=#DD3522;fontSize=10;labelBackgroundColor=#FFFFFF;;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="case003-implementada-eni" target="case003-implementada-cli"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="500" /><mxPoint x="810" y="500" /></Array></mxGeometry></mxCell>
        <mxCell id="case003-implementada-notes" value="&lt;b&gt;Resultados do lab&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&#x27;#248814&#x27;&gt;&lt;b&gt;Failover (reclamação ①)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Última resposta A 20:15:09 → primeira resposta B 20:15:44.&lt;br&gt;Indisponibilidade real &lt;b&gt;~30 s&lt;/b&gt; (contra ~2 h), quase toda de tempo humano na console.&lt;br&gt;&lt;br&gt;&lt;font color=&#x27;#248814&#x27;&gt;&lt;b&gt;Limites (② e ③)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• ENI não atravessa AZ&lt;br&gt;• eth0 não pode ser desanexada&lt;br&gt;• EIP resolve IP público, não privado&lt;br&gt;&lt;br&gt;&lt;font color=&#x27;#248814&#x27;&gt;&lt;b&gt;Ciclo de vida no terminate (④)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• eth0 de A (DoT true) → &lt;b&gt;apagada&lt;/b&gt;&lt;br&gt;• eth0 do cliente (DoT true) → &lt;b&gt;apagada&lt;/b&gt;&lt;br&gt;• eth0 de B (DoT false) → &lt;font color=&#x27;#DD3522&#x27;&gt;&lt;b&gt;Available, órfã&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• ENI do serviço (manual, DoT false) → &lt;b&gt;Available&lt;/b&gt;&lt;br&gt;&lt;br&gt;Previsão confirmada &lt;b&gt;4/4&lt;/b&gt;. A eth0 órfã travou o &lt;code&gt;DeleteSecurityGroup&lt;/code&gt; (DependencyViolation) até ser excluída." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#F2F6E8;strokeColor=#7AA116;" vertex="1" parent="1"><mxGeometry x="1130" y="90" width="330" height="560" as="geometry" /></mxCell>
        <mxCell id="case003-implementada-legend" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;■ &lt;font color=&#x27;#ED7100&#x27;&gt;EC2 ativa&lt;/font&gt; · ■ &lt;font color=&#x27;#879196&#x27;&gt;EC2 com falha simulada&lt;/font&gt;&lt;br&gt;■ &lt;font color=&#x27;#8C4FFF&#x27;&gt;ENI&lt;/font&gt; · ▭ &lt;font color=&#x27;#DD3522&#x27;&gt;Security Group&lt;/font&gt;&lt;br&gt;— &lt;font color=&#x27;#248814&#x27;&gt;Attach atual&lt;/font&gt; · ⇢ &lt;font color=&#x27;#879196&#x27;&gt;Attach anterior&lt;/font&gt;&lt;br&gt;→ &lt;font color=&#x27;#147EBA&#x27;&gt;Tráfego HTTP&lt;/font&gt; · ⇢ &lt;font color=&#x27;#DD3522&#x27;&gt;Operação bloqueada&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFFFFF;strokeColor=#879196;" vertex="1" parent="1"><mxGeometry x="1130" y="670" width="330" height="110" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="case003-recomendada" name="3 - Recomendada (NLB interno multi-AZ)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="case003-recomendada-title" value="&lt;b&gt;Case 03 — Arquitetura recomendada (quando houver orçamento e o protocolo permitir DNS)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;Os clientes deixam de depender de um IP: chamam um nome na Route 53 privada, que aponta para um NLB interno em 2 AZs com Auto Scaling. Recursos &lt;b&gt;simulados&lt;/b&gt;.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="50" as="geometry" /></mxCell>
        <mxCell id="case003-recomendada-cloud" value="AWS Cloud" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1060" height="860" as="geometry" /></mxCell>
        <mxCell id="case003-recomendada-region" value="Region us-east-1" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;fontColor=#147EBA;dashed=1;" vertex="1" parent="case003-recomendada-cloud"><mxGeometry x="20" y="40" width="1020" height="800" as="geometry" /></mxCell>
        <mxCell id="case003-recomendada-vpc" value="VPC Cedro Seguros — 172.31.0.0/16" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;fontColor=#AAB7B8;dashed=0;" vertex="1" parent="case003-recomendada-region"><mxGeometry x="20" y="40" width="980" height="740" as="geometry" /></mxCell>
        <mxCell id="case003-recomendada-r53" value="&lt;b&gt;Route 53 private hosted zone&lt;/b&gt;&lt;br&gt;cotacao.cedro.internal&lt;br&gt;(alias → NLB)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.hosted_zone;" vertex="1" parent="case003-recomendada-vpc"><mxGeometry x="446" y="40" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="case003-recomendada-nlb" value="&lt;b&gt;NLB interno&lt;/b&gt;&lt;br&gt;1 nó por AZ · health check :80" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.network_load_balancer;" vertex="1" parent="case003-recomendada-vpc"><mxGeometry x="446" y="170" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="case003-recomendada-asg" value="Auto Scaling Group · mín. 2 · 1 instância por AZ" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=center;shape=mxgraph.aws4.groupCenter;grIcon=mxgraph.aws4.group_auto_scaling_group;grStroke=1;strokeColor=#ED7100;fillColor=none;fontColor=#ED7100;dashed=1;" vertex="1" parent="case003-recomendada-vpc"><mxGeometry x="20" y="270" width="940" height="320" as="geometry" /></mxCell>
        <mxCell id="case003-recomendada-aza" value="us-east-1a" style="fillColor=none;strokeColor=#147EBA;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#147EBA;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fontSize=12;" vertex="1" parent="case003-recomendada-asg"><mxGeometry x="20" y="30" width="440" height="270" as="geometry" /></mxCell>
        <mxCell id="case003-recomendada-suba" value="Sub-rede privada" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#147EBA;fillColor=#E6F2F8;fontColor=#147EBA;dashed=0;" vertex="1" parent="case003-recomendada-aza"><mxGeometry x="15" y="35" width="410" height="220" as="geometry" /></mxCell>
        <mxCell id="case003-recomendada-m1" value="motor-cotacao-1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.instance2;" vertex="1" parent="case003-recomendada-suba"><mxGeometry x="181" y="80" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="case003-recomendada-azb" value="us-east-1b" style="fillColor=none;strokeColor=#147EBA;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#147EBA;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fontSize=12;" vertex="1" parent="case003-recomendada-asg"><mxGeometry x="480" y="30" width="440" height="270" as="geometry" /></mxCell>
        <mxCell id="case003-recomendada-subb" value="Sub-rede privada" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#147EBA;fillColor=#E6F2F8;fontColor=#147EBA;dashed=0;" vertex="1" parent="case003-recomendada-azb"><mxGeometry x="15" y="35" width="410" height="220" as="geometry" /></mxCell>
        <mxCell id="case003-recomendada-m2" value="motor-cotacao-2" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.instance2;" vertex="1" parent="case003-recomendada-subb"><mxGeometry x="181" y="80" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="case003-recomendada-cl" value="Clientes (ERP, batch, relatórios)&lt;br&gt;configurados com o &lt;b&gt;nome&lt;/b&gt;, não com IP" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.instance2;" vertex="1" parent="case003-recomendada-vpc"><mxGeometry x="130" y="640" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="case003-recomendada-dns" value="1. resolve nome" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#8C4FFF;fontColor=#8C4FFF;fontSize=10;labelBackgroundColor=#FFFFFF;;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="case003-recomendada-cl" target="case003-recomendada-r53"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="234" y="214" /></Array></mxGeometry></mxCell>
        <mxCell id="case003-recomendada-tcp" value="2. TCP :80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#147EBA;fontColor=#147EBA;fontSize=10;labelBackgroundColor=#FFFFFF;;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="case003-recomendada-cl" target="case003-recomendada-nlb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="814" /><mxPoint x="420" y="344" /></Array></mxGeometry></mxCell>
        <mxCell id="case003-recomendada-t1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#147EBA;fontColor=#147EBA;fontSize=10;labelBackgroundColor=#FFFFFF;;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="case003-recomendada-nlb" target="case003-recomendada-m1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="case003-recomendada-t2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#147EBA;fontColor=#147EBA;fontSize=10;labelBackgroundColor=#FFFFFF;;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="case003-recomendada-nlb" target="case003-recomendada-m2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="case003-recomendada-notes" value="&lt;b&gt;O que muda&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&#x27;#248814&#x27;&gt;&lt;b&gt;✔ Failover automático&lt;/b&gt;&lt;/font&gt;&lt;br&gt;O health check do NLB tira a instância doente do tráfego em segundos, sem ninguém na console.&lt;br&gt;&lt;br&gt;&lt;font color=&#x27;#248814&#x27;&gt;&lt;b&gt;✔ Multi-AZ&lt;/b&gt;&lt;/font&gt;&lt;br&gt;A queda de uma AZ derruba só metade da capacidade. A ENI não oferecia isso.&lt;br&gt;&lt;br&gt;&lt;font color=&#x27;#248814&#x27;&gt;&lt;b&gt;✔ Sem IP fixo nos clientes&lt;/b&gt;&lt;/font&gt;&lt;br&gt;O nome DNS isola os clientes de qualquer troca de instância, IP ou AZ.&lt;br&gt;&lt;br&gt;&lt;font color=&#x27;#248814&#x27;&gt;&lt;b&gt;✔ Sem ENIs órfãs&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Instâncias do ASG usam só a eth0 com Delete on termination = true.&lt;br&gt;&lt;br&gt;&lt;b&gt;Enquanto isso não é possível&lt;/b&gt;&lt;br&gt;Manter a ENI do serviço e automatizar o detach/attach: alarme do CloudWatch → Lambda (ou SSM Automation), reduzindo os ~30 s para poucos segundos." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#F2F6E8;strokeColor=#7AA116;" vertex="1" parent="1"><mxGeometry x="1130" y="90" width="330" height="520" as="geometry" /></mxCell>
        <mxCell id="case003-recomendada-legend" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;■ &lt;font color=&#x27;#ED7100&#x27;&gt;EC2 (Auto Scaling Group)&lt;/font&gt;&lt;br&gt;■ &lt;font color=&#x27;#8C4FFF&#x27;&gt;Route 53 / NLB&lt;/font&gt;&lt;br&gt;⇢ &lt;font color=&#x27;#8C4FFF&#x27;&gt;Resolução DNS&lt;/font&gt;&lt;br&gt;→ &lt;font color=&#x27;#147EBA&#x27;&gt;Tráfego da aplicação&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFFFFF;strokeColor=#879196;" vertex="1" parent="1"><mxGeometry x="1130" y="630" width="330" height="110" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
