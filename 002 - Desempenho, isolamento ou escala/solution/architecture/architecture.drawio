        <mxCell id="case002-proposta-k20" value="Dados&lt;br&gt;kafka-05" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.instance2;" vertex="1" parent="case002-proposta-part2"><mxGeometry x="40" y="35" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="case002-proposta-k21" value="Dados&lt;br&gt;kafka-06" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.instance2;" vertex="1" parent="case002-proposta-part2"><mxGeometry x="160" y="35" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="case002-proposta-k22" value="Dados&lt;br&gt;+ brokers…" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.instance2;" vertex="1" parent="case002-proposta-part2"><mxGeometry x="280" y="35" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="case002-proposta-pgpn" value="✔ Escala para centenas de brokers (mais instâncias por partição)&lt;br&gt;✔ Falha de um rack afeta só 1 partição&lt;br&gt;⚠ Até &lt;b&gt;7 partições por AZ&lt;/b&gt;; réplicas do Kafka devem ficar em partições diferentes" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontSize=11;fontColor=#8C4FFF;" vertex="1" parent="case002-proposta-pgp"><mxGeometry x="15" y="525" width="370" height="80" as="geometry" /></mxCell>
        <mxCell id="case002-proposta-notes" value="&lt;b&gt;Decisão por time&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color='#147EBA'&gt;&lt;b&gt;Pesquisa → Desempenho → Cluster&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Todos os nós juntos numa única AZ. Abre mão de isolamento; o job pode ser retomado por checkpoint.&lt;br&gt;&lt;br&gt;&lt;font color='#248814'&gt;&lt;b&gt;Pagamentos → Isolamento → Spread / Rack&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Um rack por instância. Abre mão de escala (7/AZ).&lt;br&gt;&lt;br&gt;&lt;font color='#8C4FFF'&gt;&lt;b&gt;Dados → Escala → Partition / 3&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Racks separados por partição, crescimento para centenas. Abre mão do isolamento individual.&lt;br&gt;&lt;br&gt;&lt;b&gt;Por que não um grupo só?&lt;/b&gt;&lt;br&gt;• Cluster para tudo → Pagamentos volta a cair inteiro&lt;br&gt;• Spread para tudo → Kafka limitado a 7 brokers/AZ" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#F2F6E8;strokeColor=#7AA116;" vertex="1" parent="1"><mxGeometry x="1130" y="90" width="330" height="520" as="geometry" /></mxCell>
        <mxCell id="case002-proposta-legend" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;&lt;font color='#147EBA'&gt;▭ Cluster&lt;/font&gt; · &lt;font color='#248814'&gt;▭ Spread&lt;/font&gt; · &lt;font color='#8C4FFF'&gt;▭ Partition&lt;/font&gt;&lt;br&gt;▭ Rack / domínio de falha (simulado)&lt;br&gt;■ &lt;font color='#ED7100'&gt;EC2&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFFFFF;strokeColor=#879196;" vertex="1" parent="1"><mxGeometry x="1130" y="630" width="330" height="100" as="geometry" /></mxCell>
        <mxCell id="case002-proposta-scope" value="&lt;b&gt;Evolução (fora do escopo)&lt;/b&gt;&lt;br&gt;• Pagamentos: Spread em várias AZs + ALB + ASG&lt;br&gt;• HPC: EFA / ENA e Capacity Reservation&lt;br&gt;• Kafka: broker.rack a partir do Instance Metadata" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFFFFF;strokeColor=#879196;dashed=1;" vertex="1" parent="1"><mxGeometry x="1130" y="750" width="330" height="110" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
