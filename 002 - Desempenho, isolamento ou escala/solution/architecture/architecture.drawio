<mxfile host="app.diagrams.net">
  <diagram id="case002-inicial" name="1 - Inicial (sem placement groups)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="case002-inicial-title" value="&lt;b&gt;Case 02 — Arquitetura inicial (sem placement groups)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Tudo lançado com as configurações padrão: a AWS decide em qual rack cada instância fica. Racks, sub-redes e nomes são &lt;b&gt;simulados&lt;/b&gt; para ilustrar o problema.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="50" as="geometry" /></mxCell>
