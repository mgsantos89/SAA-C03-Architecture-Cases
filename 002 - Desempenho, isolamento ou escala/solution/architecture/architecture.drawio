        <mxCell id="case002-inicial-hpcb1" value="Pesquisa&lt;br&gt;hpc-04" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.instance2;" vertex="1" parent="case002-inicial-rB1"><mxGeometry x="160" y="40" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="case002-inicial-rB2" value="Rack B2 (simulado)" style="rounded=1;arcSize=4;dashed=1;fillColor=#F5F5F5;strokeColor=#879196;fontColor=#545B64;verticalAlign=top;align=center;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fontSize=11;" vertex="1" parent="case002-inicial-subb"><mxGeometry x="15" y="470" width="400" height="140" as="geometry" /></mxCell>
        <mxCell id="case002-inicial-kd0" value="Dados&lt;br&gt;kafka-05" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.instance2;" vertex="1" parent="case002-inicial-rB2"><mxGeometry x="90" y="40" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="case002-inicial-kd1" value="Dados&lt;br&gt;kafka-06" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.instance2;" vertex="1" parent="case002-inicial-rB2"><mxGeometry x="260" y="40" width="48" height="48" as="geometry" /></mxCell>
        <mxCell id="case002-inicial-mpi" value="MPI entre AZs → ↑ latência, ↓ banda por fluxo&lt;br&gt;(job ~2× mais lento)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;endArrow=block;dashed=1;strokeColor=#DD3522;fontColor=#DD3522;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="case002-inicial-hpca1" target="case002-inicial-hpcb0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="case002-inicial-notes" value="&lt;b&gt;Chamados&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color='#DD3522'&gt;&lt;b&gt;① Pagamentos (isolamento)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;As 3 instâncias de conciliação caíram no mesmo rack A1. Uma falha de hardware derrubou &lt;b&gt;3/3&lt;/b&gt; → 40 min fora.&lt;br&gt;&lt;br&gt;&lt;font color='#DD3522'&gt;&lt;b&gt;② Pesquisa (desempenho)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Após a recriação, os nós de HPC ficaram em racks e AZs diferentes. A troca de mensagens cruza AZs e o job leva quase o dobro do tempo.&lt;br&gt;&lt;br&gt;&lt;font color='#DD3522'&gt;&lt;b&gt;③ Dados (escala)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;6 brokers Kafka espalhados sem critério; 2 deles dividem o rack A1 com Pagamentos. Ao crescer para centenas, não há domínio de falha definido.&lt;br&gt;&lt;br&gt;&lt;b&gt;Sugestões da reunião (ambas erradas)&lt;/b&gt;&lt;br&gt;• &quot;Cluster para tudo&quot; → repete o incidente ①&lt;br&gt;• &quot;Spread para todo mundo&quot; → trava o Kafka em 7 instâncias/AZ" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFF8E6;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1130" y="90" width="330" height="560" as="geometry" /></mxCell>
        <mxCell id="case002-inicial-legend" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;■ &lt;font color='#ED7100'&gt;EC2 em operação&lt;/font&gt;&lt;br&gt;■ &lt;font color='#DD3522'&gt;EC2 afetada pela falha do rack&lt;/font&gt;&lt;br&gt;▭ Rack físico (simulado)&lt;br&gt;⇢ &lt;font color='#DD3522'&gt;Tráfego com latência alta&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFFFFF;strokeColor=#879196;" vertex="1" parent="1"><mxGeometry x="1130" y="670" width="330" height="120" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="case002-proposta" name="2 - Proposta (com placement groups)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1060" math="0" shadow="0">
      <root>
